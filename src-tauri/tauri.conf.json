{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cut Note",
  "version": "0.1.0",
  "identifier": "com.cutnote.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cut Note",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["cutnote"],
        "name": "Cut Note Board",
        "description": "Cut Note board with layout and notes",
        "role": "Editor",
        "mimeType": "application/vnd.cutnote.board"
      }
    ]
  }
}
